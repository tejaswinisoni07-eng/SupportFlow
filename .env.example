# SupportFlow Environment Configuration
# Copy this file to .env to customize settings

# Backend Server Port (defaults to 5000 if not specified)
PORT=5000

# Optional: Google Gemini API Key for live AI response generation
# If left blank or omitted, SupportFlow automatically runs in transparent Demo Mode
# using the built-in intelligent contextual response generator (zero API keys required).
# GEMINI_API_KEY=
